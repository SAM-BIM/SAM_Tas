<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Library</OutputType>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="4.2.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <!-- PR7b: the generated TasGenExecute scripts are compiled at C# 7.0 in the tests (TasScriptCompiler). -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- PR7b: one snapshot of the generated script per chain shape (TasScriptTests). -->
    <None Include="Golden\TasModel\*.csx" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Same pattern as SAM.Analytical.Tas.TM59.Tests (see its TESTING.md): no ProjectReference to
         SAM.Analytical.Tas.GenOpt.csproj, because it references SAM.Core.Tas, whose <COMReference> needs the
         .NET Framework MSBuild. Reference the already-built assemblies instead; the native GenOpt types touch no
         COM type. Build SAM (SAM.Math) and SAM_Tas.sln first. -->
    <Reference Include="SAM.Analytical.Tas.GenOpt">
      <HintPath>..\..\build\SAM.Analytical.Tas.GenOpt.dll</HintPath>
    </Reference>
    <Reference Include="SAM.Core.Tas">
      <HintPath>..\..\build\SAM.Core.Tas.dll</HintPath>
    </Reference>
    <Reference Include="SAM.Math">
      <HintPath>..\..\..\SAM\build\SAM.Math.dll</HintPath>
    </Reference>
    <Reference Include="SAM.Core">
      <HintPath>..\..\..\SAM\build\SAM.Core.dll</HintPath>
    </Reference>
    <Reference Include="SAM.Core.Optimisation">
      <HintPath>..\..\..\SAM\build\SAM.Core.Optimisation.dll</HintPath>
    </Reference>
    <Reference Include="SAM.Units">
      <HintPath>..\..\..\SAM\build\SAM.Units.dll</HintPath>
    </Reference>
    <!-- PR7b: the "tas-model" glazing pool holds SAM window systems; their TBD names come from SAM_Tas' naming. -->
    <Reference Include="SAM.Analytical">
      <HintPath>..\..\..\SAM\build\SAM.Analytical.dll</HintPath>
    </Reference>
    <Reference Include="SAM.Geometry">
      <HintPath>..\..\..\SAM\build\SAM.Geometry.dll</HintPath>
    </Reference>
    <Reference Include="SAM.Architectural">
      <HintPath>..\..\..\SAM\build\SAM.Architectural.dll</HintPath>
    </Reference>
    <Reference Include="SAM.Analytical.Tas">
      <HintPath>..\..\build\SAM.Analytical.Tas.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- The protocol stand-in for TasGenExecute.exe, run as a real child process by the tests. -->
    <ProjectReference Include="..\SAM.Analytical.Tas.GenOpt.Tests.StubTasGenExecute\SAM.Analytical.Tas.GenOpt.Tests.StubTasGenExecute.csproj" />
  </ItemGroup>

</Project>
